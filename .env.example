# ---------- Azure ----------
# Option A: service principal (App registration)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Option B: leave the three above empty and run `az login` instead
AZURE_SUBSCRIPTION_ID=

# ---------- AWS (optional) ----------
# IAM user access keys (see aws_iam_policy.json for the permissions it needs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Comma-separated regions to scan for EC2 instances
AWS_REGIONS=ap-south-1

# ---------- Tuning ----------
AUTOHIBERNATE_TAG=autohibernate
# true = only log what would be stopped. Set to false only when you want real stops.
AUTOHIBERNATE_DRY_RUN=true
IDLE_CPU_THRESHOLD=5
IDLE_WINDOW_HOURS=24
# How long to wait for a stop to finish before reporting its state
STOP_TIMEOUT_SECONDS=300
