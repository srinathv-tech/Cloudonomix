{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyForCloudonomix",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "cloudwatch:GetMetricStatistics",
        "pricing:GetProducts"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StopStartOnlyTaggedInstances",
      "Effect": "Allow",
      "Action": ["ec2:StopInstances", "ec2:StartInstances"],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/autohibernate": "true" } }
    }
  ]
}
